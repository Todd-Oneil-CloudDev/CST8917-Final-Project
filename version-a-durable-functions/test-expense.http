### ============================================================
### Expense Approval Pipeline - Test Requests
### Requires: VS Code "REST Client" extension (humao.rest-client)
### Run `func start` locally before executing these
### Replace demo email addresses with your own
### ============================================================

### ------------------------------------------------------------
### Version A Durable Functions + Logic Apps
### ------------------------------------------------------------

@baseUrl = http://localhost:7071/api
@managerDecision = Approved

### ------------------------------------------------------------
### 0. Health Check
### ------------------------------------------------------------
GET {{baseUrl}}/health


### ------------------------------------------------------------
### 1. Auto-Approve Path (amount < 100)
### Expect: 202 Accepted, statusQueryGetUri returned
### ------------------------------------------------------------
# @name startAutoApprove
POST {{baseUrl}}/orchestrators/expense_orchestrator
Content-Type: application/json

{
    "employeeName": "Jane Doe",
    "employeeEmail": "test@example.com",
    "amount": 42.50,
    "category": "supplies",
    "description": "Office supplies - notebooks and pens",
    "managerEmail": "manager@example.com"
}


### ------------------------------------------------------------
### 2. Manager Approval Required Path (amount >= 100)
### Expect: 202 Accepted, orchestration will wait for external event
### ------------------------------------------------------------
# @name startManagerApproval
POST {{baseUrl}}/orchestrators/expense_orchestrator
Content-Type: application/json

{
    "employeeName": "John Smith",
    "employeeEmail": "test@example.com",
    "amount": 450.00,
    "category": "travel",
    "description": "Flight to client site",
    "managerEmail": "manager@example.com"
}

###
@managerApprovalInstanceId = {{startManagerApproval.response.body.id}}

### 2b. Manager approves the expense
### Expect: 200 OK, "Sent decision ... to instance ..."
POST {{baseUrl}}/approval/{{managerApprovalInstanceId}}
Content-Type: application/json

{
    "decision": "Approved"
}

### ------------------------------------------------------------
### 3. Manager Rejection Path
### ------------------------------------------------------------
# @name startRejection
POST {{baseUrl}}/orchestrators/expense_orchestrator
Content-Type: application/json

{
    "employeeName": "Alice Nguyen",
    "employeeEmail": "test@example.com",
    "amount": 899.99,
    "category": "equipment",
    "description": "New monitor for home office",
    "managerEmail": "manager@example.com"
}
### 
@rejectionInstanceId = {{startRejection.response.body.id}}

### 3a. Manager rejects the expense
POST {{baseUrl}}/approval/{{rejectionInstanceId}}
Content-Type: application/json

{
    "decision": "Rejected"
}

### ------------------------------------------------------------
### 4. Escalation Path (manager doesn't respond within timeout window)
### Start this, then simply DO NOT call the approval endpoint.
### Wait longer than your timeout (currently 60s) and poll.
### ------------------------------------------------------------
# @name startEscalation
POST {{baseUrl}}/orchestrators/expense_orchestrator
Content-Type: application/json

{
    "employeeName": "Bob Lee",
    "employeeEmail": "test@example.com",
    "amount": 250.00,
    "category": "software",
    "description": "Annual license renewal",
    "managerEmail": "manager@example.com"
}

###
@escalationInstanceId = {{startEscalation.response.body.id}}

### wait 60+ seconds for timeout, escalation email should follow shorly after

### ------------------------------------------------------------
### 5. Validation Failures - Starter Function
### ------------------------------------------------------------

### 5a. Missing required fields (missing amount, managerEmail)
### Expect: 400, "Missing required fields: amount, managerEmail"
POST {{baseUrl}}/orchestrators/expense_orchestrator
Content-Type: application/json

{
    "employeeName": "Missing Fields Test",
    "employeeEmail": "test@example.com",
    "category": "travel",
    "description": "Testing missing fields"
}

### 5b. Invalid JSON body
### Expect: 400, "Invalid JSON in request body"
POST {{baseUrl}}/orchestrators/expense_orchestrator
Content-Type: application/json

{ this is not valid json }

### 5c. Amount is not a number (string instead)
### Expect: 400, "... is not a number type."
POST {{baseUrl}}/orchestrators/expense_orchestrator
Content-Type: application/json

{
    "employeeName": "Bad Amount Test",
    "employeeEmail": "test@example.com",
    "amount": "one hundred",
    "category": "travel",
    "description": "Testing non-numeric amount",
    "managerEmail": "manager@example.com"
}

### 5d. Invalid category (should still start orchestration, but resolve to Rejected)
# @name startInvalidCategory
POST {{baseUrl}}/orchestrators/expense_orchestrator
Content-Type: application/json

{
    "employeeName": "Invalid Category Test",
    "employeeEmail": "test@example.com",
    "amount": 75.00,
    "category": "vacation",
    "description": "Testing invalid category",
    "managerEmail": "manager@example.com"
}

###
@invalidCategoryInstanceId = {{startInvalidCategory.response.body.id}}

### 5e. Poll status - expect status "Rejected", reason "vacation is not a valid category"
GET {{baseUrl}}/orchestrators/expense_orchestrator/instances/{{invalidCategoryInstanceId}}


### ------------------------------------------------------------
### 6. Validation Failures - Manager Approval Endpoint
### ------------------------------------------------------------

### 6a. Approval call against a nonexistent instance ID
### Expect: 404, "Instance Not Found"
POST {{baseUrl}}/approval/00000000000000000000000000000000
Content-Type: application/json

{
    "decision": "Approved",
}

### 6b. Approval call missing 'decision' field
### Expect: 400, "Missing required fields: decision"
POST {{baseUrl}}/approval/{{managerApprovalInstanceId}}
Content-Type: application/json

{
    "reason": "Forgot to include a decision"
}

### 6c. Approval call with an invalid decision value
### Expect: 400, "... is not a valid response. Must be either 'Approved' or 'Rejected'"
POST {{baseUrl}}/approval/{{managerApprovalInstanceId}}
Content-Type: application/json

{
    "decision": "Maybe"
}